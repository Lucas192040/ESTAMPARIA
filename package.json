{
  "name": "estamparia",
  "version": "1.0.0",
  "description": "Acompanhamento da produção da Estamparia com Supabase, importação transacional e apontamento por programação.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:network": "node --experimental-strip-types --test tests/network-access.test.mjs",
    "test:database": "node --import tsx scripts/test-database.ts",
    "inspect:excel": "node --import tsx scripts/inspect-excel.ts",
    "test:api": "node --conditions=react-server --import tsx scripts/test-api.ts",
    "test:concurrency": "node --env-file-if-exists=.env.test --import tsx scripts/test-concurrency.ts",
    "verify:connection": "node --env-file=.env.local --import tsx scripts/verify-connection.ts",
    "format": "prettier --write src scripts tests *.json *.ts *.mjs README.md docs/*.md",
    "test:migration": "node scripts/check-migrations.mjs",
    "test:sql": "node --test tests/sql-safeupdate.test.mjs",
    "test:timeout": "node --experimental-strip-types --test tests/db-timeout.node.test.mjs",
    "test:revision": "node --experimental-strip-types --test tests/revision-row.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "fflate": "0.8.3",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22 <25"
  }
}
