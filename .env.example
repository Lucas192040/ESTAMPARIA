# URL de conexão POOLED do Neon (hostname -pooler). SOMENTE servidor.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-POOLER/DB?sslmode=require
# URL pública exata da aplicação (exemplo: https://estamparia.exemplo.com).
APP_ORIGIN=https://SUA-URL.vercel.app
# Exige que o deploy tenha proteção REAL de acesso, inclusive para /api/*.
# NÃO é um sistema de autenticação.
ACCESS_RESTRICTION_CONFIRMED=false

# Autenticação por setor (somente servidor). Troque por senhas fortes quando possível.
ESTAMPARIA_PASSWORD=estamp123
RADIADOR_PASSWORD=rad123
# Gere uma chave aleatória com pelo menos 32 caracteres e mantenha igual em todas as instâncias.
# Se ausente, o servidor usa DATABASE_URL como segredo de fallback para sessões.
AUTH_SESSION_SECRET=COLOQUE_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES_AQUI
