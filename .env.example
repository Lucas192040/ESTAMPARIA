# URL de conexão POOLED do Neon (hostname -pooler). SOMENTE servidor.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-POOLER/DB?sslmode=require
# URL pública exata da aplicação (exemplo: https://estamparia.exemplo.com).
APP_ORIGIN=https://SUA-URL.vercel.app
# Exige que o deploy tenha proteção REAL de acesso, inclusive para /api/*.
# NÃO é um sistema de autenticação.
ACCESS_RESTRICTION_CONFIRMED=false
